# This file is for universal compatibility on any machine (Mac, Windows, Linux CPU).
FROM ubuntu:22.04

# Set up environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV SHELL=/bin/bash

# Install basic utilities and Miniconda
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O ~/miniconda.sh && \
    /bin/bash ~/miniconda.sh -b -p /opt/conda && \
    rm ~/miniconda.sh && \
    /opt/conda/bin/conda clean -all -f -y && \
    ln -s /opt/conda/etc/profile.d/conda.sh /etc/profile.d/conda.sh

# Set the working directory
WORKDIR /app

# --- THE KEY DIFFERENCE ---
# We will use a separate, CPU-only environment file.
COPY environment-cpu.yaml .

# Accept Anaconda TOS and create the Conda environment
RUN . /opt/conda/etc/profile.d/conda.sh && \
    conda config --set allow_conda_downgrades true && \
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main && \
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r && \
    conda env create -f environment-cpu.yaml && \
    conda clean -afy

# Copy the rest of the application code
# COPY . .
COPY cardio_form/ ./cardio_form
COPY scripts/ ./scripts
COPY docker/entrypoint.py ./scripts/
COPY models.yaml .
COPY labels.yaml .

# Set PYTHONPATH so Python can find the cardio_form module
ENV PYTHONPATH=/app

RUN mkdir -p /.cache/cardio_form

# Define the entrypoint
ENTRYPOINT ["/opt/conda/envs/cardioform-cpu/bin/python", "scripts/entrypoint.py"]
CMD ["--help"]
