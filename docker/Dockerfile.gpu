# Use an official NVIDIA image with CUDA and Conda pre-installed
# This ensures GPU support is available inside the container
FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

# Set up environment variables to prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV SHELL=/bin/bash

# Install basic utilities and Miniconda
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* && \
    wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O ~/miniconda.sh && \
    /bin/bash ~/miniconda.sh -b -p /opt/conda && \
    rm ~/miniconda.sh && \
    /opt/conda/bin/conda clean -all -f -y && \
    ln -s /opt/conda/etc/profile.d/conda.sh /etc/profile.d/conda.sh

# Set the working directory
WORKDIR /app

# Copy the environment file first to leverage Docker layer caching
# This layer only rebuilds if environment.yaml changes
COPY environment.yaml .

# Accept Anaconda TOS and create the Conda evironment
RUN . /opt/conda/etc/profile.d/conda.sh && \
    conda config --set allow_conda_downgrades true && \
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main && \
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r && \
    conda env create -f environment.yaml && \
    conda clean -afy

# Copy the application code (src/ layout) and config manifests
COPY pyproject.toml README.md ./
COPY src/ ./src
COPY models.yaml .
COPY labels.yaml .

# Install the shared pycemrg core (pinned, from PyPI) and CardioForm itself.
# --no-deps keeps pip from re-resolving the conda-managed scientific stack.
RUN . /opt/conda/etc/profile.d/conda.sh && conda activate cardioform && \
    pip install --no-cache-dir "pycemrg==0.1.1" && \
    pip install --no-cache-dir -e . --no-deps

# Create cache directory
RUN mkdir -p /.cache/cardio_form

# Define the entrypoint (console script installed by `pip install -e .`)
ENTRYPOINT ["/opt/conda/envs/cardioform/bin/cardioform"]
CMD ["--help"]
